# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cracklist?schema=public"

# Server
PORT=4000
# Comma-separated allowed origins for CORS (the Vite dev server)
CORS_ORIGIN="http://localhost:5173"

# Moderator auth
ADMIN_PASSWORD="change-me-in-prod"
# Secret used to sign the session cookie (any long random string)
SESSION_SECRET="dev-only-insecure-secret-change-me"

# Where uploaded PDFs are stored on local disk (v1 storage backend)
UPLOAD_DIR="uploads"
