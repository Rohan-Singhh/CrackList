// CrackList data model — mirrors the PRD 1:1.
// Four tables: companies, users, questions, pdf_submissions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's pooled connection (pgbouncer, port 6543) doesn't support the
  // prepared statements `prisma db push`/`migrate` need — directUrl points
  // those commands at the direct connection (port 5432) instead. Runtime
  // queries still go through `url` (the pooler).
  directUrl = env("DIRECT_URL")
}

enum QuestionStatus {
  pending
  approved
  rejected
}

enum SourceType {
  indexed
  community_submitted // maps to "community-submitted" at the API edge
}

enum IntakePath {
  structured
  pdf_email // maps to "pdf-email" at the API edge
}

model Company {
  id             String     @id @default(cuid())
  name           String
  normalizedSlug String     @unique @map("normalized_slug")
  logoUrl        String?    @map("logo_url")
  questions      Question[]

  @@map("companies")
}

model User {
  id              String     @id @default(cuid())
  handle          String     @unique
  email           String?
  submissionCount Int        @default(0) @map("submission_count")
  approvedCount   Int        @default(0) @map("approved_count")
  questions       Question[] @relation("SubmittedBy")

  @@map("users")
}

model Question {
  id              String          @id @default(cuid())
  companyId       String          @map("company_id")
  company         Company         @relation(fields: [companyId], references: [id])
  roleLevel       String          @map("role_level")
  roundType       String          @map("round_type")
  questionText    String          @map("question_text")
  codeSnippet     String?         @map("code_snippet")
  topicTags       String[]        @map("topic_tags")
  askedMonthYear  String?         @map("asked_month_year")
  // Indexed-dataset fields (e.g. bulk LeetCode-by-company imports). Null for
  // community-submitted interview questions, which have no LC problem behind them.
  difficulty      String?
  frequency       Float?
  link            String?
  submittedByHandle String?       @map("submitted_by")
  submittedBy     User?           @relation("SubmittedBy", fields: [submittedByHandle], references: [handle])
  status          QuestionStatus  @default(pending)
  rejectionReason String?         @map("rejection_reason")
  sourceType      SourceType      @default(community_submitted) @map("source_type")
  sourceUrl       String?         @map("source_url")
  sourceLabel     String?         @map("source_label")
  intakePath      IntakePath?     @map("intake_path")
  upvoteCount     Int             @default(0) @map("upvote_count")
  // Client-supplied UUID that deduplicates POST /submissions/structured —
  // a double-tap on Submit reuses the same key and the second request
  // returns the row created by the first instead of writing a duplicate.
  // Nullable so seeded/imported rows don't need one.
  idempotencyKey  String?         @unique @map("idempotency_key")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([companyId])
  @@index([status])
  @@map("questions")
}

// Immutable audit trail for every consequential moderator action —
// approve, reject, and (in future) any other mutation that changes
// public state. Written in the same transaction as the state change
// so an action row either exists with its effect visible or neither
// does. Never updated or deleted from application code.
model ModAction {
  id           String   @id @default(cuid())
  actor        String   // moderator identifier (frontend hardcodes '@rohan' today)
  action       String   // 'approve' | 'reject' — string not enum so adding future actions doesn't need a migration
  targetType   String   @map("target_type") // 'question' | (later) 'pdf_submission'
  targetId     String   @map("target_id")
  beforeStatus String?  @map("before_status")
  afterStatus  String?  @map("after_status")
  reason       String?
  // Coarse client fingerprint — no exact IP, since we'll usually only ever have
  // one moderator. Enough to notice if the shared password is used from an
  // unexpected place.
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("mod_actions")
}

model PdfSubmission {
  id         String   @id @default(cuid())
  email      String
  filename   String
  note       String   @default("")
  // Storage key returned by storage/pdf.ts — the moderator download route
  // uses this to fetch the file back out of Supabase (or local disk).
  // Nullable so historical rows from the ephemeral-disk era don't break.
  storageKey String?  @map("storage_key")
  // Same dedup story as questions.idempotencyKey.
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("pdf_submissions")
}
